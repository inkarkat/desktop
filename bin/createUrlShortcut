#!/bin/bash
set -o pipefail

: ${FAVORITES_DIR:=~/Favorites}

readonly scriptDir="$([ "${BASH_SOURCE[0]}" ] && dirname -- "${BASH_SOURCE[0]}" || exit 3)"
[ -d "$scriptDir" ] || { echo >&2 'ERROR: Cannot determine script directory!'; exit 3; }
readonly projectDir="${scriptDir}/.."
readonly etcDir="${projectDir}/etc/$(basename -- "${BASH_SOURCE[0]}")"
readonly templateFilespec="${etcDir}/entry.desktop.template"

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, they can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" '[-n|--name NAME] [-i|--icon ICON] [-C|--comment COMMENT] [-e|--favorite ""|FAVORITE-SUBDIR|-d|--destination DESTINATION-DIR] [-f|--force] [-T|--target-name DESKTOP-ENTRY] [--] URL [-?|-h|--help]'
    printf 'Usage: %q %s\n' "$(basename "$1")" '--check ...'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Create a DESKTOP-ENTRY for URL.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --check		Check whether DESKTOP-ENTRY (and ICON) already exist (by
			name, ignoring the contents).
    --name|-n NAME	Use NAME instead of deriving it from URL.
    --icon|-i ICON	Use ICON; if this is a ./FILESPEC (not just a name),
			copy it to the application icon location and embed just
			the name.
    --comment|-C COMMENT
			Use COMMENT.
    --destination|-d DESTINATION-DIR
			Place the desktop entry into DESTINATION-DIR.
			The default is the current directory.
    --favorite|-e ""	Save directly in ${FAVORITES_DIR} as a
			favorite shortcut.
    --favorite|-e FAVORITE-SUBDIR
			Save in FAVORITE-SUBDIR of ${FAVORITES_DIR}
			as a favorite shortcut.
    --force|-f		Overwrite an existing desktop entry.
    --target-name|-T DESKTOP-ENTRY
			The filename of the desktop entry to be created.
			Defaults to NAME / the title of the web page at URL.
HELPTEXT
}

processIcon()
{
    desktopIcon="${1:?}"; shift
    if [[ "$desktopIcon" =~ / ]]; then
	if [ ! -r "$desktopIcon" ]; then
	    printf >&2 'ERROR: Icon does not exist at %s\n', "$desktopIcon"
	    exit 2
	fi
	iconFilespec="$desktopIcon"
	desktopIcon="$(basename -- "$desktopIcon")"
    fi
}

desktopName=
iconFilespec=
desktopIcon='text-html'
desktopComment=
destinationDirspec=
isForce=
desktopEntryName=
isCheck=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--check)	shift; isCheck=t;;
	--name|-n)	shift; desktopName="$1"; shift;;
	--icon|-i)	shift; processIcon "$1"; shift;;
	--comment|-C)	shift; desktopComment="$1"; shift;;
	--favorite|-e)
			shift; destinationDirspec="${FAVORITES_DIR}/${1?}"; shift
			if [ ! -d "$destinationDirspec" ]; then
			    printf >&2 'ERROR: No such favorite subdirectory: %s\n' "${destinationDirspec%/}/"
			    exit 1
			fi
			;;
	--destination|-d)
			shift; destinationDirspec="${1:?}"; shift;;
	--force|-f)	shift; isForce=t;;
	--target-name|-T)
			shift; desktopEntryName="${1:?}"; shift;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -ne 1 ]; then
    printUsage "$0" >&2
    exit 2
fi
desktopUrl="${1:?}"; shift

if [ -z "$desktopName" ]; then
    desktopName="$(
	getWebPage --quiet -- "$desktopUrl" \
	    | xmllint --html --xpath 'string(//title)' - 2>/dev/null
    )"

    if [ -z "$desktopName" ]; then
	desktopName="$(urlmodify +domain -- "$desktopUrl" 2>/dev/null)"
	desktopName="${desktopName:+_}$(timestamp --sortable --short)"
    fi
fi
: ${desktopEntryName:="${desktopName:?}"}
targetFilespec="${destinationDirspec%/}/${desktopEntryName%.desktop}.desktop"

if [ "$isCheck" ]; then
    [ -e "$targetFilespec" ] || exit 1
    [ -z "$iconFilespec" ] || addIcon --check -- "$iconFilespec" || exit 1
    exit 0
elif [ -e "$targetFilespec" ] && [ ! "$isForce" ]; then
    printf >&2 'ERROR: Desktop entry already exists at: %s\n' "$targetFilespec"
    exit 1
fi

export ${!desktop@}
shelltemplate --target "$targetFilespec" -- "$templateFilespec" || exit $?

[ -z "$iconFilespec" ] || acceptStatus 0 4 99 -- addIcon --copy ${isForce:+--force} -- "$iconFilespec"
